# ── Data sources (read-only) ───────────────────────────────────────────
FINNHUB_API_KEY=            # R4.1 earnings calendar + estimates/actuals
FMP_API_KEY=                # R4.2 peer/competitor lists
ALPHAVANTAGE_API_KEY=       # R4.3 prices, indicators, news/sentiment

# ── Claude analyst ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=          # R2.5 Claude as analyst (judgment only)

# ── Brokers (execution) ────────────────────────────────────────────────
# Alpaca — primary (options + paper). Use PAPER keys until validated.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Execution mode: propose_only (safe default), paper (virtual sandbox), or live (real money)
# Note: ALPACA_PAPER is deprecated and paper routing is now controlled by EXECUTION_MODE.
EXECUTION_MODE=propose_only

# Robinhood Agentic — secondary (stocks only today). Leave blank until enabled.
ROBINHOOD_AGENTIC_TOKEN=

# ── Alerts (R8) ────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_USERNAME=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# ── Storage (R6.4 backend-only Supabase) ───────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PRESCIENT_STORAGE_SCHEMA=prescient_storage
